# Copy to .env.production on the server (NOT in git) and fill in real values.
# In CI/CD this file is written from GitHub Environment secrets at deploy time.

# --- MongoDB Atlas (production cluster, separate from any dev/staging cluster) ---
MONGODB_HOST=your-prod-cluster.mongodb.net
MONGODB_USERNAME=prod_db_user
MONGODB_PASSWORD=

# --- Auth ---
GOOGLE_CLIENT_ID=214227450442-gp12srosdps9365qbfum19dvnutu9gi5.apps.googleusercontent.com
# Generate with: openssl rand -hex 32 — never reuse the dev/test value.
JWT_SECRET=

# --- Frontend origin(s) allowed to call this API (comma-separated) ---
CLIENT_URLS=https://app.yourdomain.org

# --- SendGrid (shift reminder emails) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.org
